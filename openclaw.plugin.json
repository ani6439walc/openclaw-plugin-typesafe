{
  "id": "typesafe",
  "name": "TypeSafe AI",
  "description": "Typed decision provider for hosted Jev and local System One models.",
  "categories": ["developer-tools"],
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "decisionProviders": ["typesafe"]
  },
  "configContracts": {
    "secretInputs": {
      "bundledDefaultEnabled": false,
      "paths": [
        {
          "path": "apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "TypeSafe API credential",
      "help": "Select a SecretRef in Settings → Secrets for hosted Jev or a custom API root. Ignored for a bare loopback origin (local Kev). Never paste credentials in chat.",
      "sensitive": true
    },
    "timeoutMs": {
      "label": "Request timeout (ms)",
      "advanced": true
    },
    "baseUrl": {
      "label": "System One API root",
      "help": "Optional HTTP(S) API root, such as https://decision.example.com/typesafe/v1. The plugin appends /systemone; an origin implies /v1. A bare loopback origin selects unauthenticated local Kev. Omit for hosted Jev."
    }
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "object",
        "required": ["source", "provider", "id"],
        "properties": {
          "source": {
            "anyOf": [
              {
                "type": "string",
                "const": "env"
              },
              {
                "type": "string",
                "const": "store"
              },
              {
                "type": "string",
                "const": "file"
              },
              {
                "type": "string",
                "const": "exec"
              }
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 30000
      },
      "baseUrl": {
        "type": "string",
        "maxLength": 2048,
        "pattern": "^https?://[^\\s/@?#]+(?:/[^\\s?#]*)?$"
      }
    },
    "additionalProperties": false
  },
  "decisionModels": [
    {
      "provider": "typesafe",
      "id": "jev-latest",
      "name": "Jev",
      "capabilities": {
        "questionTypes": ["boolean", "choice", "score"],
        "maxQuestions": 256,
        "maxChoiceAlternatives": 255,
        "maxScoreLevels": 10,
        "confidence": "provider-specific"
      }
    },
    {
      "provider": "typesafe",
      "id": "jev-1.13.0",
      "name": "Jev 1.13.0",
      "capabilities": {
        "questionTypes": ["boolean", "choice", "score"],
        "maxQuestions": 256,
        "maxChoiceAlternatives": 255,
        "maxScoreLevels": 10,
        "confidence": "provider-specific"
      }
    },
    {
      "provider": "typesafe",
      "id": "kev-latest",
      "name": "Kev (local server)",
      "capabilities": {
        "questionTypes": ["boolean", "choice", "score"],
        "maxQuestions": 256,
        "maxChoiceAlternatives": 255,
        "maxScoreLevels": 10,
        "confidence": "provider-specific"
      }
    }
  ]
}
