{
  "name": "typesafe",
  "version": "2026.10.6",
  "description": "OpenClaw TypeSafe typed decision provider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ani6439walc/openclaw-plugin-typesafe.git"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "prettier": "3.9.10"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.6",
      "minGatewayVersion": "2026.10.6"
    },
    "build": {
      "openclawVersion": "2026.10.6",
      "pluginSdkVersion": "2026.10.6"
    }
  },
  "displayName": "TypeSafe AI",
  "homepage": "https://github.com/ani6439walc/openclaw-plugin-typesafe#readme",
  "bugs": {
    "url": "https://github.com/ani6439walc/openclaw-plugin-typesafe/issues"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.md' '**/*.json' '**/*.ts'",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "test:plugin-loader": "node --input-type=module --eval \"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url); require('./dist/index.js');\""
  },
  "peerDependencies": {
    "openclaw": "2026.10.6"
  },
  "files": [
    "README.md",
    "LICENSE",
    "package.json",
    "openclaw.plugin.json",
    "dist",
    "assets",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ]
}
